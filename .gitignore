node_modules/
.env
.env.local
*.log
.DS_Store

# Stale pre-rename snapshot of the original handoff. Kept locally for
# reference; not part of the source tree.
encode-project.zip

# Local scratch clones the incident pipeline leaves behind if a run is
# interrupted before cleanupRepo().
tmp/

# The SQLite incident store — real settlement records and payer addresses.
data/
*.db
*.db-wal
*.db-shm

# Secrets. `everything encode.txt` holds a live agent-wallet private key, the
# X402 settlement key and a GitHub PAT. It is untracked by luck rather than by
# design — it happened to be created after the last `git add -A`. Anything
# named like a secret belongs here, including files added while working.
everything encode.txt
*.env
*.env.*
!*.env.example
*secret*
*secrets*
*credentials*
*.privatekey
*.pem
