{
  "name": "encode-api",
  "version": "1.0.0",
  "description": "Encode — automated incident diagnosis and fix agent, paid per resolved incident over x402 on Celo.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
