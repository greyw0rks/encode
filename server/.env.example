# --- LLM provider ---
# Encode talks to one Anthropic-shaped API. That can be Anthropic itself, or
# Qwen's Anthropic-compatible endpoint. Leave ANTHROPIC_BASE_URL unset for
# Anthropic; set it to the Qwen endpoint to use Qwen.
#
# Provider is inferred from the base URL; LLM_PROVIDER overrides it. Note the
# Claude Agent SDK path only works against real Anthropic — on Qwen, the
# Coding Agent falls back to Encode's own tool loop automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# LLM_PROVIDER=anthropic          # anthropic | qwen (optional, usually inferred)

# Model overrides. Defaults per provider:
#   anthropic → claude-haiku-4-5-20251001 / claude-sonnet-4-6
#   qwen      → qwen3.7-plus / qwen3.7-max  (plain qwen-plus/qwen-max do NOT resolve on DashScope)
LLM_MODEL_DIAGNOSIS=
LLM_MODEL_CODING=

# --- Encode agent wallet (receives x402 settlements) ---
ENCODE_WALLET_ADDRESS=0x...
ENCODE_WALLET_PRIVATE_KEY=0x...

# --- Celo ---
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN=celo
CELO_NETWORK_ENV=mainnet          # mainnet | testnet

# --- x402 ---
# Leave blank to use the correct API host for CELO_NETWORK_ENV automatically:
#   mainnet → https://api.x402.celo.org
#   testnet → https://api.x402.sepolia.celo.org
# Do NOT set this to https://x402.celo.org — that's the dashboard SPA and
# returns HTML for /verify.
X402_FACILITATOR_URL=

# Required to actually settle a payment. POST /verify works without it, so an
# integration looks healthy right up until its first settlement 401s.
# Get one from the dashboard at https://x402.celo.org (connect wallet → create
# API key → sign an off-chain message). Server-side only: whoever holds this
# can spend Encode's settlement credits.
X402_API_KEY=

# --- ERC-8004 / ERC-8021 ---
# Blank until registered at celobuilders.xyz. Unattributed settlements don't
# appear on the hackathon leaderboard at all.
ERC8004_AGENT_ID=
ERC8021_ATTRIBUTION_TAG=

# --- Pricing (USD, quoted at request time) ---
PRICE_TRIAGE=1.50
PRICE_FIX=8.00

# --- GitHub (for opening fix PRs) ---
GITHUB_TOKEN=

# --- Server ---
PORT=8787
