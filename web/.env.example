# Local overrides. The site works with neither set: `apiBase()` in lib/api.ts
# falls back to the deployed API in lib/facts.ts, so an unconfigured deployment
# reads real data rather than rendering "no API URL configured".
#
# Build/render-time base URL for the Encode API. Server components fetch
# ENCODE_API_URL; NEXT_PUBLIC_ENCODE_API_URL is the browser-side equivalent,
# for anything that reads the API from a client component.
ENCODE_API_URL=http://localhost:8787
NEXT_PUBLIC_ENCODE_API_URL=http://localhost:8787
