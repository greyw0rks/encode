# Local overrides. The site works with neither set.
#
# Build/render-time base URL for the Encode API. Server components fetch
# ENCODE_API_URL; the browser only ever needs NEXT_PUBLIC_ENCODE_API_URL for
# the client-side refresh of the ledger.
ENCODE_API_URL=http://localhost:8787
NEXT_PUBLIC_ENCODE_API_URL=http://localhost:8787
